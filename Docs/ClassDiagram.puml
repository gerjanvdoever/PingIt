@startuml
title PingIt - Database Schema (Updated ERD)

entity Users {
  +int Id
  --
  string FirstName
  string LastName
  string Email
  string PasswordHash
  string Role
  string? PhoneNumber
  bool WantsNotifications
  string Street
  string HouseNumber
  string PostalCode
  string City
}

entity Incidents {
  +int Id
  --
  string Title
  string? Description
  decimal Latitude
  decimal Longitude
  datetime CreatedAt
  string Status
  string Priority
  datetime? Deadline
  datetime? HandledAt
  int? CreatedByUserId
  bool HandledByExternal
  int? HandledByUserId
  string? Notes
}

entity IncidentPhotos {
  +int Id
  --
  int IncidentId
  string PhotoUrl
}

entity IncidentStatusHistory {
  +int Id
  --
  int IncidentId
  string Status
  int ChangedByUserId
  datetime ChangedAt
}

' RELATIONS
Users ||--o{ Incidents : creates
Users ||--o{ IncidentStatusHistory : changes status
Incidents ||--o{ IncidentPhotos
Incidents ||--o{ IncidentStatusHistory
Users ||--o{ Incidents : handles

@enduml