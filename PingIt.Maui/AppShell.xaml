<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PingIt.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PingIt.Maui"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />
    <ShellContent ContentTemplate="{DataTemplate views:AccountPage}" Route="AccountPage" />
    <ShellContent ContentTemplate="{DataTemplate views:RegisterPage}" Route="RegisterPage" />
    <ShellContent ContentTemplate="{DataTemplate views:ReportIncidentPage}" Route="ReportIncidentPage" />
    <ShellContent ContentTemplate="{DataTemplate views:IncidentListPage}" Route="IncidentListPage" />
    <ShellContent ContentTemplate="{DataTemplate views:MyIncidentDetail}" Route="MyIncidentDetail" />
    <ShellContent ContentTemplate="{DataTemplate views:IncidentMapPage}" Route="IncidentMapPage" />
    <ShellContent ContentTemplate="{DataTemplate views:IncidentDetailPage}" Route="IncidentDetailPage" />
    <ShellContent ContentTemplate="{DataTemplate views:MyAccountDetailPage}" Route="MyAccountDetailPage" />
</Shell>
