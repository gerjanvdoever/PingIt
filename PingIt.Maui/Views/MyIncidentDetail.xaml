<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  x:Class="PingIt.Maui.Views.MyIncidentDetail"
  Shell.NavBarIsVisible="False"
  x:DataType="vm:MyIncidentDetailViewModel"
  BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}">

    <Grid RowDefinitions="Auto,*,Auto">

        <views:TopNavBar
            Grid.Row="0"
            Title="{Binding Incident.Title}"
            ShowBackButton="True" />

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="0">
            <VerticalStackLayout Spacing="0">

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,16,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
                                Offset="0,2" 
                                Radius="8" 
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Incident Title"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                            <Entry Text="{Binding Incident.Title, Mode=TwoWay}"
                                   FontSize="20"
                                   FontFamily="OpenSansSemibold"
                                   Placeholder="Enter incident title"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="4">
                                <Label Text="Status"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#DDF4FF, Dark=#0C2D6B}"
                                        Stroke="{AppThemeBinding Light=#54AEFF, Dark=#1F6FEB}"
                                        StrokeThickness="1"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="{Binding Incident.Status}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="4">
                                <Label Text="Created"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                <Label Text="{Binding Incident.CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="14"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" 
                                                 Spacing="4"
                                                 IsVisible="{Binding HasHandledAt}">
                                <Label Text="Handled"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                <Label Text="{Binding Incident.HandledAt, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                       FontSize="14"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light=#1A7F37, Dark=#3FB950}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Description Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
                                Offset="0,2" 
                                Radius="8" 
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Description"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                        <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                Padding="16,12"
                                StrokeShape="RoundRectangle 8">
                            <Editor Text="{Binding Incident.Description, Mode=TwoWay}"
                                    AutoSize="TextChanges"
                                    Placeholder="Enter incident description..."
                                    MinimumHeightRequest="120"
                                    FontSize="15"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                    PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Photos Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1"
                        IsVisible="{Binding Incident.Photos.Count}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
                                Offset="0,2" 
                                Radius="8" 
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Photos"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Incident.Photos.Count, StringFormat='{0} photos'}"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <CollectionView ItemsSource="{Binding Incident.Photos}"
                                            ItemsLayout="HorizontalList"
                                            HeightRequest="140">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:IncidentPhotoDto">
                                        <Border Margin="0,0,12,0"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent">
                                            <Border.Shadow>
                                                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
                                                        Offset="0,2" 
                                                        Radius="6" 
                                                        Opacity="0.15" />
                                            </Border.Shadow>

                                            <Border StrokeShape="RoundRectangle 12"
                                                    Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#21262D}">
                                                <Image Source="{Binding PhotoUrl}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="120"
                                                       HeightRequest="120">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyIncidentDetailViewModel}}, Path=ShowFullscreenImageCommand}"
                                                                              CommandParameter="{Binding PhotoUrl}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Location Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,16"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
                                Offset="0,2" 
                                Radius="8" 
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <Label Text="Location"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}">
                            <views:MapView HeightRequest="220"
                                           PinItems="{Binding PinItems}"
                                           ShowUserLocation="False"
                                           IsPinSelectionEnabled="False" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Bar -->
        <Border Grid.Row="2"
        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
        StrokeThickness="1"
        Padding="20,16">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" 
            Offset="0,-2" 
            Radius="8" 
            Opacity="0.1" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <!-- Save Changes-->
                <Button Grid.Column="0"
            Text="Save Changes"
            Command="{Binding SaveIncidentCommand}"
            FontSize="16"
            FontFamily="OpenSansSemibold"
            TextColor="White"
            BackgroundColor="{StaticResource Primary}"
            CornerRadius="10"
            Padding="24,12" />

                <!-- Delete-->
                <Button Grid.Column="1"
            Command="{Binding DeleteIncidentCommand}"
            BackgroundColor="{AppThemeBinding Light=#FFF1F0, Dark=#4C1B1B}"
            BorderColor="{AppThemeBinding Light=#FD8C8C, Dark=#DA3633}"
            BorderWidth="1"
            CornerRadius="10"
            WidthRequest="48" HeightRequest="48"
            ImageSource="delete.png">
                    <Button.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#FD8C8C, Dark=#DA3633}" 
                Offset="0,2" 
                Radius="4" 
                Opacity="0.15" />
                    </Button.Shadow>
                </Button>

            </Grid>
        </Border>

        <!-- Fullscreen Image Overlay -->
        <Grid Grid.RowSpan="3"
      IsVisible="{Binding IsImageFullscreen}"
      BackgroundColor="#CC000000"
      InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseFullscreenImageCommand}" />
            </Grid.GestureRecognizers>

            <!-- Make the border fill the available space -->
            <Border BackgroundColor="Black"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            Margin="20"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand">
                <Border.Shadow>
                    <Shadow Brush="Black" 
                    Offset="0,8" 
                    Radius="24" 
                    Opacity="0.3" />
                </Border.Shadow>

                <Grid RowDefinitions="*,Auto">
                    <Image Source="{Binding FullscreenImageUrl}"
                   Aspect="AspectFit"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />
                    <Button Grid.Row="1"
                    Text="✕"
                    Command="{Binding CloseFullscreenImageCommand}"
                    BackgroundColor="#80000000"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="8" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>