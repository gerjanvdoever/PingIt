<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  xmlns:conv="clr-namespace:PingIt.Maui.Converters"
  x:Class="PingIt.Maui.Views.MyIncidentDetail"
  Shell.NavBarIsVisible="False"
  x:DataType="vm:MyIncidentDetailViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Top Bar -->
        <views:TopNavBar
      Grid.Row="0"
      Title="{Binding Incident.Title}"
      ShowBackButton="True" />

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <!-- Editable Title -->
                <Entry
          Text="{Binding Incident.Title, Mode=TwoWay}"
          FontSize="18"
          FontAttributes="Bold"
          Placeholder="Titel"
          HorizontalOptions="FillAndExpand" />

                <!-- Editable Description -->
                <Editor
          Text="{Binding Incident.Description, Mode=TwoWay}"
          AutoSize="TextChanges"
          Placeholder="Beschrijving"
          HeightRequest="150"
          HorizontalOptions="FillAndExpand" />

                <Label
          Text="{Binding Incident.CreatedAt, StringFormat='Aangemaakt op: {0:dd MMM yyyy}'}"
          FontSize="14" />

                <Label
          Text="{Binding Incident.Status, StringFormat='Status: {0}'}"
          FontSize="14" />

                <Label
          Text="{Binding Incident.HandledAt, StringFormat='Afgehandeld op: {0:dd MMM yyyy}'}"
          FontSize="14"
          IsVisible="{Binding HasHandledAt}" />

                <!-- Photos -->
                <CollectionView
          ItemsSource="{Binding Incident.Photos}"
          ItemsLayout="HorizontalList"
          HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IncidentPhotoDto">
                            <Image
                Source="{Binding PhotoUrl}"
                Aspect="AspectFill"
                WidthRequest="100"
                HeightRequest="100"
                Margin="5"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Map -->
                <views:MapView
          HeightRequest="200"
          PinItems="{Binding PinItems}"
          ShowUserLocation="False"
          IsPinSelectionEnabled="False" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save/Delete buttons -->
        <HorizontalStackLayout
      Grid.Row="2"
      Spacing="20"
      Padding="0,10"
      HorizontalOptions="Center">
            <Button
        Text="Opslaan"
        Command="{Binding SaveIncidentCommand}"
        WidthRequest="120" />
            <Button
        Text="Verwijderen"
        Command="{Binding DeleteIncidentCommand}"
        BackgroundColor="Transparent"
        TextColor="Red"
        WidthRequest="120" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
