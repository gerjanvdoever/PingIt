<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  xmlns:conv="clr-namespace:PingIt.Maui.Converters"
  x:Class="PingIt.Maui.Views.MyIncidentDetail"
  Shell.NavBarIsVisible="False"
  x:DataType="vm:MyIncidentDetailViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Top Bar -->
        <views:TopNavBar
      Grid.Row="0"
      Title="{Binding Incident.Title}"
      ShowBackButton="True" />

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label Text="{Binding Incident.Description}" />

                <Label
          Text="{Binding Incident.CreatedAt, StringFormat='Aangemaakt op: {0:dd MMM yyyy}'}" />

                <Label
          Text="{Binding Incident.Status, StringFormat='Status: {0}'}" />

                <!-- Photos -->
                <CollectionView
          ItemsSource="{Binding Incident.Photos}"
          ItemsLayout="HorizontalList"
          HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IncidentPhotoDto">
                            <Image
                Source="{Binding PhotoUrl}"
                Aspect="AspectFill"
                WidthRequest="100"
                HeightRequest="100"
                Margin="5"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
