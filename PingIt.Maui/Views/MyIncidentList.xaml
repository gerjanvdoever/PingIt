<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PingIt.Maui.Views.MyIncidentList"
    x:DataType="vm:MyIncidentListViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Custom Top Bar -->
        <views:TopNavBar
      Title="Mijn Incidenten"
      ShowBackButton="True" />

        <!-- Incident List -->
        <CollectionView
            Grid.Row="1"
  x:Name="IncidentList"
    ItemsSource="{Binding Incidents}"
    SelectionMode="Single"
    SelectedItem="{Binding SelectedIncident, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:IncidentDto">
                    <Border
            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
            Margin="0,5"
            Padding="12"
            StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="4">
                            <!-- Title -->
                            <Label
                Text="{Binding Title}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <!-- Created Date -->
                            <Label
                Text="{Binding CreatedAt, StringFormat='Aangemaakt: {0:dd MMM yyyy}'}"
                FontSize="14"
                TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />

                            <!-- Status -->
                            <Label
                Text="{Binding Status}"
                FontSize="14"
                FontAttributes="Italic"
                TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
