<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PingIt.Maui.Converters"
             x:Class="PingIt.Maui.Views.BottomNavBar"
             x:Name="FooterRoot">

    <Grid ColumnDefinitions="*,*,*"
          BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1C1C1E}"
          Padding="10">

        <Button Text="Map"
                Grid.Column="0"
                Command="{Binding NavigateMapCommand, Source={x:Reference FooterRoot}}"
                FontSize="16"
                BackgroundColor="Transparent"
                TextColor="{Binding CurrentPage, Source={x:Reference FooterRoot}, Converter={StaticResource PageToColorConverter}, ConverterParameter=MapPage}" />

        <Button Text="List"
                Grid.Column="1"
                Command="{Binding NavigateListCommand, Source={x:Reference FooterRoot}}"
                FontSize="16"
                BackgroundColor="Transparent"
                TextColor="{Binding CurrentPage, Source={x:Reference FooterRoot}, Converter={StaticResource PageToColorConverter}, ConverterParameter=IncidentListPage}" />

        <Button Text="Account"
                Grid.Column="2"
                Command="{Binding NavigateAccountCommand, Source={x:Reference FooterRoot}}"
                FontSize="16"
                BackgroundColor="Transparent"
                TextColor="{Binding CurrentPage, Source={x:Reference FooterRoot}, Converter={StaticResource PageToColorConverter}, ConverterParameter=AccountPage}" />
    </Grid>
</ContentView>
