<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PingIt.Maui.Converters"
             x:Class="PingIt.Maui.Views.BottomNavBar"
             x:Name="FooterRoot">
    <ContentView.Resources>
        <converters:PageToBackgroundConverter x:Key="PageToBackgroundConverter" />
    </ContentView.Resources>

    <Grid ColumnDefinitions="*,*,*"
          BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1C1C1E}"
          Padding="10">

        <!-- Map Navigation -->
        <Border Grid.Column="0"
                BackgroundColor="{Binding CurrentPage, Source={x:Reference FooterRoot}, Converter={StaticResource PageToBackgroundConverter}, ConverterParameter=IncidentMapPage}"
                StrokeThickness="0"
                Padding="8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="map.png"
                       WidthRequest="32"
                       HeightRequest="32"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateMapCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Text="Map"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
            </StackLayout>
        </Border>

        <!-- List Navigation -->
        <Border Grid.Column="1"
                BackgroundColor="{Binding CurrentPage, Converter={StaticResource PageToBackgroundConverter}, ConverterParameter=IncidentListPage}"
                StrokeThickness="0"
                Padding="8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="list.png"
                       WidthRequest="32"
                       HeightRequest="32"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateListCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Text="List"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
            </StackLayout>
        </Border>

        <!-- Account Navigation -->
        <Border Grid.Column="2"
                BackgroundColor="{Binding CurrentPage, Converter={StaticResource PageToBackgroundConverter}, ConverterParameter=AccountPage}"
                StrokeThickness="0"
                Padding="8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="profile.png"
                       WidthRequest="32"
                       HeightRequest="32"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateAccountCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Text="Account"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
            </StackLayout>
        </Border>

    </Grid>
</ContentView>