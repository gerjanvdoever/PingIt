<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PingIt.Maui.Views.MyAccountDetailPage"
             xmlns:views="clr-namespace:PingIt.Maui.Views"
             Title="Account Details"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <views:TopNavBar 
            Grid.Row="0"
            Title="Account Details"
            ShowBackButton="True"/>

        <!-- Main Content Grid -->
        <ScrollView Grid.Row="1" Padding="20">
            <Grid
                ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*'}"
                RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='*'}"
                ColumnSpacing="20"
                RowSpacing="25">

                <!-- Profile Info Section -->
                <Border
                    Grid.Column="{OnPlatform Android=0, WinUI=0}"
                    Grid.Row="{OnPlatform Android=0, WinUI=0}"
                    Background="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <StackLayout Spacing="20">
                        <Label Text="Profile Information"
                               FontSize="{OnPlatform Android=20, WinUI=17}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                               HorizontalOptions="Center"/>

                        <StackLayout Spacing="15">
                            <!-- Reusable Fields -->
                            <StackLayout>
                                <Label Text="First Name" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding FirstName}" Placeholder="Enter first name" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="Last Name" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding LastName}" Placeholder="Enter last name" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="Email Address" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding Email}" Placeholder="Enter email address" Keyboard="Email" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="Phone Number" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding PhoneNumber}" Placeholder="Enter phone number" Keyboard="Telephone" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="Street" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding Street}" Placeholder="Enter street" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="House Number" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding HouseNumber}" Placeholder="Enter house number" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="Postal Code" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding PostalCode}" Placeholder="Enter postal code" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout>
                                <Label Text="City" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Entry Text="{Binding City}" Placeholder="Enter city" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                                <Label Text="Send me notifications about my Incidents" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch IsToggled="{Binding WantsNotifications}" HorizontalOptions="EndAndExpand"/>
                            </StackLayout>
                        </StackLayout>

                        <Button Text="Save Changes"
                                Command="{Binding SaveChangesCommand}"
                                BackgroundColor="{AppThemeBinding Light=#007ACC, Dark=#4FC3F7}"
                                TextColor="White"
                                FontSize="{OnPlatform Android=16, WinUI=14}"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="25"
                                Margin="0,10,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Change Password Section -->
                <Border
                    Grid.Column="{OnPlatform Android=0, WinUI=1}"
                    Grid.Row="{OnPlatform Android=1, WinUI=0}"
                    Background="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <StackLayout Spacing="15">
                        <Label Text="Change Password"
                               FontSize="{OnPlatform Android=20, WinUI=17}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                               HorizontalOptions="Center"/>

                        <StackLayout>
                            <Label Text="Current Password" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Enter current password" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                        </StackLayout>

                        <StackLayout>
                            <Label Text="New Password" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Enter new password" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Confirm New Password" FontSize="{OnPlatform Android=14, WinUI=13}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Confirm new password" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" HeightRequest="45" FontSize="{OnPlatform Android=16, WinUI=14}"/>
                        </StackLayout>

                        <Label Text="Password must be at least 8 characters long and include an uppercase letter, a lowercase letter, and a number." FontSize="{OnPlatform Android=12, WinUI=11}" TextColor="{AppThemeBinding Light=#999999, Dark=#BBBBBB}" LineBreakMode="WordWrap"/>

                        <Button Text="Change Password" Command="{Binding ChangePasswordCommand}" BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8A50}" TextColor="White" FontSize="{OnPlatform Android=16, WinUI=14}" FontAttributes="Bold" HeightRequest="50" CornerRadius="25" Margin="0,10,0,0"/>
                    </StackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand"
              Grid.RowSpan="2"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{AppThemeBinding Light=#007ACC, Dark=#4FC3F7}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>