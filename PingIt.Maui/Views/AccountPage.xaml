<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
             x:Class="PingIt.Maui.Views.AccountPage"
             Title="Account"
             BackgroundColor="LightGray">

    <ContentPage.BindingContext>
        <vm:AccountViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Profile Header -->
            <Border Stroke="Transparent" StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                    <Image Source="profile_icon.png" WidthRequest="80" HeightRequest="80" />
                    <Label Text="Gebruikersnaam"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Border Stroke="Transparent" StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <!-- Incident melden -->
                    <Grid Padding="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="incident_icon.png" WidthRequest="24" HeightRequest="24" />
                        <Label Grid.Column="1"
                               Text="Incident melden"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="Gray" />
                    <!-- Mijn incidenten -->
                    <Grid Padding="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="incidentlist_icon.png" WidthRequest="24" HeightRequest="24" />
                        <Label Grid.Column="1"
                               Text="Mijn incidenten"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Logout -->
            <Border Stroke="Transparent" StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                <Grid Padding="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="logout_icon.png" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1"
                           Text="Uitloggen"
                           FontSize="16"
                           VerticalOptions="Center"
                           Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Label Text="Footer als admin of worker"
                   HorizontalOptions="Center"
                   VerticalOptions="EndAndExpand"
                   FontSize="14"
                   TextColor="Gray"
                   Margin="0,40,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>