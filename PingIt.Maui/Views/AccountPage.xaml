<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    x:Class="PingIt.Maui.Views.AccountPage"
    x:DataType="vm:AccountViewModel"
    Title="Account">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Main Content -->
        <ScrollView Grid.Row="1"
                    IsEnabled="{Binding IsNotBusy}">
            <VerticalStackLayout Padding="30"
                                 Spacing="20"
                                 VerticalOptions="Center">

                <!-- Profile Section -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="10">
                    <Image Source="user.png"
                           WidthRequest="40"
                           HeightRequest="40" />
                    <Label Text="{Binding FullName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Actions Section -->
                <VerticalStackLayout Spacing="15">
                    <Button Text="Report an incident"
                            IsEnabled="{Binding AllowReport}"
                            Command="{Binding NavigateReportCommand}"
                            ImageSource="incident_icon.png"
                            HorizontalOptions="Fill"
                            CornerRadius="25"
                            FontAttributes="Bold" />

                    <Button Text="My incidents"
                            Command="{Binding NavigateListCommand}"
                            ImageSource="incidentlist_icon.png"
                            HorizontalOptions="Fill"
                            CornerRadius="25"
                            FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Logout -->
                <Button Text="Logout"
                        Command="{Binding LogoutCommand}"
                        Margin="0,20,0,0"
                        CornerRadius="25"
                        FontAttributes="Bold" />
            </VerticalStackLayout>
        </ScrollView>

        <views:BottomNavBar Grid.Row="2"
                            CurrentPage="AccountPage" />

        <!-- Busy overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              InputTransparent="False"
              BackgroundColor="{StaticResource OverlayDark}">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="White" />
        </Grid>
    </Grid>
</ContentPage>
