<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  x:Class="PingIt.Maui.Views.MyIncidentDetailWindowsPage"
  Shell.NavBarIsVisible="False"
  x:DataType="vm:MyIncidentDetailViewModel"
  BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}"
  Title="My Incident Details">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Navigation Bar -->
        <views:TopNavBar
            Grid.Row="0"
            Title="{Binding Incident.Title}"
            ShowBackButton="True" />

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" Padding="16">
            <Grid ColumnDefinitions="2*,1*" RowDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="16">

                <!-- Left Column - Main Content -->
                <VerticalStackLayout Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Spacing="16">

                    <!-- Header Card: Title & Created At -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Padding="32,24"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                    Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Entry Text="{Binding Incident.Title, Mode=TwoWay}"
                                       FontSize="24"
                                       FontFamily="OpenSansSemibold"
                                       Placeholder="Enter incident title"
                                       TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                       BackgroundColor="Transparent"
                                       PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}" />
                                <Label
                                    Text="{Binding Incident.CreatedAt, StringFormat='Created: {0:dd MMM yyyy HH:mm}'}"
                                    FontSize="14"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                            </VerticalStackLayout>

                            <!-- Status Badge -->
                            <Border Grid.Column="1" 
                                    BackgroundColor="{AppThemeBinding Light=#DDF4FF, Dark=#0C2D6B}"
                                    Stroke="{AppThemeBinding Light=#54AEFF, Dark=#1F6FEB}"
                                    StrokeThickness="1"
                                    Padding="12,6"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Start">
                                <Label
                                    Text="{Binding Incident.Status}"
                                    FontSize="12"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Description Card -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Padding="32,24"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                    Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label
                                Text="Description"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                    Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                    StrokeThickness="1"
                                    Padding="16,12"
                                    StrokeShape="RoundRectangle 8">
                                <Editor Text="{Binding Incident.Description, Mode=TwoWay}"
                                        AutoSize="TextChanges"
                                        Placeholder="Enter incident description..."
                                        MinimumHeightRequest="120"
                                        FontSize="15"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                        PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Photos Card -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Padding="32,24"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1"
                        IsVisible="{Binding Incident.Photos.Count}">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                    Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="Photos"
                                    FontSize="18"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Incident.Photos.Count, StringFormat='{0} photos'}"
                                    FontSize="13"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                            </Grid>

                            <CollectionView
                                ItemsSource="{Binding Incident.Photos}"
                                VerticalOptions="FillAndExpand">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout 
                                        Orientation="Vertical" 
                                        Span="3" 
                                        HorizontalItemSpacing="12" 
                                        VerticalItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:IncidentPhotoDto">
                                        <Border 
                                            StrokeShape="RoundRectangle 12" 
                                            BackgroundColor="Transparent">
                                            <Border.Shadow>
                                                <Shadow 
                                                    Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                                    Offset="0,2" 
                                                    Radius="6" 
                                                    Opacity="0.15" />
                                            </Border.Shadow>
                                            <Border
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                                StrokeThickness="1"
                                                BackgroundColor="{AppThemeBinding Light=White, Dark=#21262D}">
                                                <Image
                                                    Source="{Binding PhotoUrl}"
                                                    Aspect="AspectFit"
                                                    HeightRequest="250"
                                                    VerticalOptions="FillAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyIncidentDetailViewModel}}, Path=ShowFullscreenImageCommand}"
                                                            CommandParameter="{Binding PhotoUrl}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Right Column - Info Panel -->
                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Spacing="16">

                    <!-- Details Card -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                    Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="20">
                            <Label
                                Text="Details"
                                FontSize="16"
                                FontFamily="OpenSansSemibold"
                                TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Status"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#DDF4FF, Dark=#0C2D6B}"
                                            Stroke="{AppThemeBinding Light=#54AEFF, Dark=#1F6FEB}"
                                            StrokeThickness="1"
                                            Padding="8,4"
                                            StrokeShape="RoundRectangle 6">
                                        <Label Text="{Binding Incident.Status}"
                                               FontSize="13"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4"
                                                     IsVisible="{Binding HasHandledAt}">
                                    <Label
                                        Text="Handled"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Label
                                        Text="{Binding Incident.HandledAt, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                        FontSize="14"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#1A7F37, Dark=#3FB950}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Location Card -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                    Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label
                                Text="Location"
                                FontSize="16"
                                FontFamily="OpenSansSemibold"
                                TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Map view is not available on this device."
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                <Button
                                    Text="Open in Google Maps"
                                    Command="{Binding OpenInGoogleMapsCommand}"
                                    FontSize="14"
                                    Padding="16,10"
                                    CornerRadius="8" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- Action Bar -->
        <Border
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
            Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
            StrokeThickness="1"
            Padding="20,16">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                        Offset="0,-2" Radius="8" Opacity="0.1" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" HorizontalOptions="Fill">
                <Label Grid.Column="0" 
                       Text="Make your changes and save when ready"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                       VerticalOptions="Center" />

                <!-- Save Changes Button -->
                <Button Grid.Column="1"
                        Text="Save Changes"
                        Command="{Binding SaveIncidentCommand}"
                        FontSize="16"
                        FontFamily="OpenSansSemibold"
                        TextColor="White"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="10"
                        Padding="32,12"
                        HorizontalOptions="End" />

                <!-- Delete Button -->
                <Button Grid.Column="2"
                        Command="{Binding DeleteIncidentCommand}"
                        BackgroundColor="{AppThemeBinding Light=#FFF1F0, Dark=#4C1B1B}"
                        BorderColor="{AppThemeBinding Light=#FD8C8C, Dark=#DA3633}"
                        BorderWidth="1"
                        CornerRadius="10"
                        WidthRequest="48" HeightRequest="48"
                        ImageSource="delete.png">
                    <Button.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#FD8C8C, Dark=#DA3633}" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.15" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>

        <!-- Fullscreen Image Overlay -->
        <Grid
            Grid.RowSpan="3"
            IsVisible="{Binding IsImageFullscreen}"
            BackgroundColor="#CC000000"
            InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseFullscreenImageCommand}" />
            </Grid.GestureRecognizers>
            <Border
                BackgroundColor="Black"
                StrokeShape="RoundRectangle 12"
                Margin="20"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.3" />
                </Border.Shadow>
                <Grid RowDefinitions="*,Auto">
                    <Image
                        Source="{Binding FullscreenImageUrl}"
                        Aspect="AspectFit"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                    <Button
                        Grid.Row="1"
                        Text="✕"
                        Command="{Binding CloseFullscreenImageCommand}"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="20"
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="8" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>