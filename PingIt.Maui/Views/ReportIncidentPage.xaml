<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    x:Class="PingIt.Maui.Views.ReportIncidentPage"
    x:Name="MainPage"
    x:DataType="vm:ReportIncidentViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}">

    <Grid RowDefinitions="Auto,*,Auto">

        <views:TopNavBar
            Grid.Row="0"
            Title="Report Incident"
            ShowBackButton="True" />

        <ScrollView Grid.Row="1" Padding="0" IsEnabled="{Binding IsNotBusy}">
            <VerticalStackLayout Spacing="0">

                <Border BackgroundColor="{AppThemeBinding Light=#FFF8DC, Dark=#2D2A1F}"
                        Margin="16,16,16,8"
                        Padding="20,16"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#F59E0B, Dark=#D97706}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#F59E0B, Dark=#D97706}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.1" />
                    </Border.Shadow>

                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                            <Label Text="Suspicious Activity or Emergency?"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" />
                            <Label Text="For immediate danger, call emergency services!"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#A16207, Dark=#FDE68A}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="What happened?"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                        <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                Padding="16,12"
                                StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding Title, Mode=TwoWay}"
                                   Placeholder="Brief title (e.g., Litter, Vandalism)"
                                   FontSize="15"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                   PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Provide a short but detailed description"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                        <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                Padding="16,12"
                                StrokeShape="RoundRectangle 8">
                            <Editor Text="{Binding Description, Mode=TwoWay}"
                                    AutoSize="TextChanges"
                                    Placeholder="What exactly did you observe?"
                                    MinimumHeightRequest="100"
                                    FontSize="15"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                    PlaceholderColor="{AppThemeBinding Light=#8C959F, Dark=#6E7681}"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,8"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Can you please add some photos?"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <Label Text="Visual evidence helps us respond more effectively"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                        </VerticalStackLayout>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12">

                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                        StrokeThickness="2"
                                        StrokeDashArray="4,4"
                                        BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                        WidthRequest="120"
                                        HeightRequest="120">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddPhotoCommand}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="8" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center">
                                        <Border BackgroundColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}"
                                                StrokeShape="RoundRectangle 20"
                                                WidthRequest="40"
                                                HeightRequest="40">
                                            <Label Text="+"
                                                   FontSize="24"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="Add Photo"
                                               FontSize="12"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    </VerticalStackLayout>
                                </Border>

                                <CollectionView ItemsSource="{Binding Photos}"
                                    ItemsLayout="HorizontalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="ImageSource">
                                            <Grid Margin="0,0,12,0">
                                                <!-- Main photo container -->
                                                <Border StrokeShape="RoundRectangle 12"
                                                        BackgroundColor="Transparent">
                                                    <Border.Shadow>
                                                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                                                Offset="0,2"
                                                                Radius="6"
                                                                Opacity="0.15" />
                                                    </Border.Shadow>
                                                    <Border StrokeShape="RoundRectangle 12"
                                                            Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#21262D}">
                                                        <Image Source="{Binding .}"
                                                               Aspect="AspectFill"
                                                               WidthRequest="120"
                                                               HeightRequest="120" />
                                                    </Border>
                                                </Border>

                                                <!-- Delete button -->
                                                <Border BackgroundColor="{AppThemeBinding Light=#DC2626, Dark=#EF4444}"
                                                        StrokeShape="RoundRectangle 12"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="0,-8,-8,0">
                                                    <Border.Shadow>
                                                        <Shadow Brush="Black"
                                                                Offset="0,2"
                                                                Radius="4"
                                                                Opacity="0.3" />
                                                    </Border.Shadow>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.RemovePhotoCommand, Source={x:Reference Name=MainPage}}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>

                                                    <Label Text="×"
                                                           FontSize="16"
                                                           FontFamily="OpenSansSemibold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           LineHeight="1" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                        Margin="16,8,16,16"
                        Padding="24,20"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Where did you observe this?"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <Label Text="Tap on the map to mark the exact location"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                        </VerticalStackLayout>

                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}">
                            <views:MapView HeightRequest="220"
                                           ShowUserLocation="{Binding ShowUserLocation}"
                                           SelectedLocation="{Binding NewIncidentCoord, Mode=TwoWay}"/>
                        </Border>

                        <Button Text="Use My Current Location"
                                Command="{Binding UseCurrentLocationCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="15"
                                FontFamily="OpenSansSemibold"
                                TextColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}"
                                BackgroundColor="{AppThemeBinding Light=#DDF4FF, Dark=#0C2D6B}"
                                BorderColor="{AppThemeBinding Light=#54AEFF, Dark=#1F6FEB}"
                                BorderWidth="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#54AEFF, Dark=#1F6FEB}"
                                        Offset="0,2"
                                        Radius="4"
                                        Opacity="0.15" />
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                StrokeThickness="1"
                Padding="20,16"
                IsEnabled="{Binding IsNotBusy}">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                        Offset="0,-2"
                        Radius="8"
                        Opacity="0.1" />
            </Border.Shadow>

            <Button Text="Submit Report"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="18"
                    FontFamily="OpenSansSemibold"
                    TextColor="White"
                    BackgroundColor="{AppThemeBinding Light=#DC2626, Dark=#EF4444}"
                    CornerRadius="12"
                    Padding="24,16"
                    HorizontalOptions="FillAndExpand">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#DC2626, Dark=#EF4444}"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.3" />
                </Button.Shadow>
            </Button>
        </Border>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              InputTransparent="False"
              BackgroundColor="#CC000000">
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                    StrokeThickness="1"
                    Padding="32,24"
                    WidthRequest="200"
                    HeightRequest="140"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}"
                                       WidthRequest="32"
                                       HeightRequest="32" />
                    <Label Text="Please wait..."
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>