<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  x:Class="PingIt.Maui.Views.IncidentListPage"
  x:DataType="vm:IncidentListViewModel"
  Title="Actieve Incidenten">

    <Grid>
        <Grid RowDefinitions="*,Auto" Padding="0">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Label
            Text="{Binding StatusMessage}"
            TextColor="{AppThemeBinding Light=Red, Dark=OrangeRed}"
            FontSize="12"
            IsVisible="{Binding StatusMessage.Length}" />

                    <Button
            Text="Ververs actieve incidenten"
            Command="{Binding LoadIncidentsCommand}"
            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <CollectionView
            ItemsSource="{Binding Incidents}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
            EmptyView="Geen actieve incidenten gevonden.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:IncidentDto">
                                <Border
                  Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                  StrokeThickness="1"
                  BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                  Margin="0,5"
                  Padding="12"
                  StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                      Text="{Binding Title}"
                      FontSize="16"
                      FontAttributes="Bold"
                      TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label
                      Text="{Binding Priority}"
                      FontSize="14"
                      FontAttributes="Italic"
                      TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                                        <Label
                      Text="{Binding Deadline,
                             StringFormat='Deadline: {0:dd MMM yyyy HH:mm}',
                             TargetNullValue='Geen deadline'}"
                      FontSize="14"
                      TextColor="{AppThemeBinding Light=#CC0000, Dark=#FF6666}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
            Text="Toon Afgesloten Incidenten"
            Command="{Binding LoadClosedIncidentsCommand}"
            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <CollectionView
            ItemsSource="{Binding ClosedIncidents}"
            IsVisible="{Binding ShowClosed}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
            EmptyView="Geen afgesloten incidenten gevonden.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:IncidentDto">
                                <Border
                  Stroke="{AppThemeBinding Light=#999999, Dark=#333333}"
                  StrokeThickness="1"
                  BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}"
                  Margin="0,5"
                  Padding="12"
                  StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                      Text="{Binding Title}"
                      FontSize="16"
                      FontAttributes="Bold"
                      TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label
                      Text="{Binding Priority}"
                      FontSize="14"
                      FontAttributes="Italic"
                      TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />
                                        <Label
                      Text="{Binding Deadline,
                             StringFormat='Deadline: {0:dd MMM yyyy HH:mm}',
                             TargetNullValue='Geen deadline'}"
                      FontSize="14"
                      TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <views:BottomNavBar
        Grid.Row="1"
        CurrentPage="IncidentListPage" />

        </Grid>

        <Grid
      IsVisible="{Binding IsLoading}"
      InputTransparent="False"
      BackgroundColor="{StaticResource OverlayDark}">
            <ActivityIndicator
        IsRunning="{Binding IsLoading}"
        HorizontalOptions="Center"
        VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
