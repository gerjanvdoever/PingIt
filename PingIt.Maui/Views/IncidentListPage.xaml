<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
             xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
             xmlns:views="clr-namespace:PingIt.Maui.Views"
             x:Class="PingIt.Maui.Views.IncidentListPage"
             x:DataType="vm:IncidentListViewModel"
             Title="Actieve Incidenten">

<Grid RowDefinitions="*,Auto" Padding="0">

    <!-- Main Content -->
    <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="15">

                <ActivityIndicator IsVisible="{Binding IsLoading}"
                            IsRunning="{Binding IsLoading}"
                            Color="{AppThemeBinding Light=Gray, Dark=LightGray}" />

                <Label Text="{Binding StatusMessage}"
                TextColor="{AppThemeBinding Light=Red, Dark=OrangeRed}"
                FontSize="12"
                IsVisible="{Binding StatusMessage.Length}" />

                <CollectionView ItemsSource="{Binding Incidents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IncidentDto">
                            <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                            Margin="0,5"
                            Padding="12"
                            StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                    <Label Text="{Binding Priority}"
                                    FontSize="14"
                                    FontAttributes="Italic"
                                    TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    <views:BottomNavBar Grid.Row="1" CurrentPage="IncidentListPage" />

</Grid>
</ContentPage>
