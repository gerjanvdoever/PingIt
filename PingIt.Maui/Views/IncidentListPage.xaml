<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
  xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
  xmlns:views="clr-namespace:PingIt.Maui.Views"
  x:Class="PingIt.Maui.Views.IncidentListPage"
  x:DataType="vm:IncidentListViewModel"
  Title="Active Incidents"
  BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pull-to-refresh + CollectionView -->
        <RefreshView
      Grid.Row="0"
      IsRefreshing="{Binding IsLoading}"
      Command="{Binding LoadIncidentsCommand}"
      RefreshColor="{AppThemeBinding Light=#0969DA, Dark=#58A6FF}">

            <CollectionView
        ItemsSource="{Binding Incidents}"
        SelectionMode="Single"
        SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
        BackgroundColor="Transparent">

                <!-- header -->
                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,16,16,8" Spacing="4">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                Text="Active Incidents"
                FontSize="18"
                FontFamily="OpenSansSemibold"
                TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                        </HorizontalStackLayout>
                        <Label
              Text="{Binding Incidents.Count, StringFormat='{0} active'}"
              FontSize="14"
              FontFamily="OpenSansRegular"
              TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- ITEM TEMPLATE: active incidents -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:IncidentDto">
                        <Border BackgroundColor="Transparent" Padding="20,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentListViewModel}}, Path=NavigateToDetailCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D1117}"
                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                StrokeThickness="1"
                Padding="16"
                StrokeShape="RoundRectangle 10">
                                <Border.Shadow>
                                    <Shadow
                    Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                    Offset="0,1"
                    Radius="3"
                    Opacity="0.12" />
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto">
                                    <Label
                    Grid.Row="0" Grid.Column="0"
                    Text="{Binding Title}"
                    FontSize="16"
                    FontFamily="OpenSansSemibold"
                    TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                    LineBreakMode="TailTruncation" />
                                    <Border
                    Grid.Row="0" Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=#FFF8DC, Dark=#3C2415}"
                    Stroke="{AppThemeBinding Light=#E3CC2D, Dark=#9A6700}"
                    StrokeThickness="1"
                    Padding="8,4"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Start">
                                        <Label
                      Text="{Binding Priority}"
                      FontSize="12"
                      FontFamily="OpenSansSemibold"
                      TextColor="{AppThemeBinding Light=#9A6700, Dark=#E3CC2D}" />
                                    </Border>
                                    <Label
                    Grid.Row="1" Grid.ColumnSpan="2"
                    Text="{Binding Deadline, StringFormat='Deadline: {0:dd MMM yyyy HH:mm}', TargetNullValue='No deadline'}"
                    FontSize="13"
                    FontFamily="OpenSansRegular"
                    TextColor="{AppThemeBinding Light=#D73A49, Dark=#F85149}"
                    Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- FOOTER: show/hide closed incidents + closed list -->
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="8" Padding="16,8,16,16">
                        <Button
            Text="Show Closed Incidents"
            Command="{Binding LoadClosedIncidentsCommand}"
            FontSize="15"
            FontFamily="OpenSansSemibold"
            BackgroundColor="Transparent"
            BorderColor="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
            BorderWidth="1"
            CornerRadius="8"
            TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                           Binding="{Binding ShowClosed}"
                           Value="True">
                                    <Setter Property="Text" Value="Hide Closed Incidents" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <CollectionView
              ItemsSource="{Binding ClosedIncidents}"
              IsVisible="{Binding ShowClosed}"
              SelectionMode="None"
              BackgroundColor="Transparent">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:IncidentDto">
                                    <Border
                BackgroundColor="{AppThemeBinding Light=#FAFBFC, Dark=#0D1117}"
                Stroke="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                StrokeThickness="1"
                Padding="16"
                StrokeShape="RoundRectangle 10"
                Opacity="0.8"
                Margin="0,4,0,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentListViewModel}}, Path=NavigateToDetailCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto">
                                            <Label
                        Grid.Row="0" Grid.Column="0"
                        Text="{Binding Title}"
                        FontSize="16"
                        FontFamily="OpenSansRegular"
                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                        LineBreakMode="TailTruncation" />
                                            <Border
                        Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                        StrokeThickness="1"
                        Padding="8,4"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Start">
                                                <Label
                          Text="{Binding Priority}"
                          FontSize="12"
                          FontFamily="OpenSansRegular"
                          TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                            </Border>
                                            <Label
                        Grid.Row="1" Grid.ColumnSpan="2"
                        Text="{Binding Deadline, StringFormat='Deadline: {0:dd MMM yyyy HH:mm}', TargetNullValue='No deadline'}"
                        FontSize="13"
                        FontFamily="OpenSansRegular"
                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                        Margin="0,8,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- Bottom navigation -->
        <views:BottomNavBar
      Grid.Row="1"
      CurrentPage="IncidentListPage" />

        <!-- Loading overlay -->
        <Grid
      IsVisible="{Binding IsLoading}"
      InputTransparent="False"
      BackgroundColor="{StaticResource OverlayDark}">
            <ActivityIndicator
        IsRunning="{Binding IsBusy}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Color="White" />
        </Grid>
    </Grid>
</ContentPage>
