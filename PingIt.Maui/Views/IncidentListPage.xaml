<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    x:Class="PingIt.Maui.Views.IncidentListPage"
    x:DataType="vm:IncidentListViewModel"
    Title="Incidents"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0">

                <!-- Active Incidents -->
                <CollectionView
                    ItemsSource="{Binding Incidents}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                    BackgroundColor="Transparent"
                    Margin="0,0,0,16">
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="16,16,16,8" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label
                                        Text="Active Incidents"
                                        FontSize="18"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                                    <Label
                                        Text="{Binding Incidents.Count, StringFormat='{0} active'}"
                                        FontSize="14"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="↻"
                                    Command="{Binding RefreshCommand}"
                                    BackgroundColor="Transparent"
                                    BorderColor="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    FontSize="18"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                                    Padding="0"
                                    VerticalOptions="Center">
                                    <Button.Shadow>
                                        <Shadow
                                            Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                            Offset="0,1"
                                            Radius="2"
                                            Opacity="0.1" />
                                    </Button.Shadow>
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IncidentDto">
                            <Border
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D1117}"
                                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 10"
                                Margin="16,4,16,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentListViewModel}}, Path=NavigateToDetailCommand}" 
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow
                                        Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                        Offset="0,1"
                                        Radius="3"
                                        Opacity="0.12" />
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Row="0" 
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        FontSize="16"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}"
                                        LineBreakMode="TailTruncation" />
                                    <Border
                                        Grid.Row="0" 
                                        Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#FFF8DC, Dark=#3C2415}"
                                        Stroke="{AppThemeBinding Light=#E3CC2D, Dark=#9A6700}"
                                        StrokeThickness="1"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="{Binding Priority}"
                                            FontSize="12"
                                            FontFamily="OpenSansSemibold"
                                            TextColor="{AppThemeBinding Light=#9A6700, Dark=#E3CC2D}" />
                                    </Border>
                                    <Label
                                        Grid.Row="1" 
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Deadline, StringFormat='Deadline: {0:dd MMM yyyy HH:mm}', TargetNullValue='No deadline'}"
                                        FontSize="13"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#D73A49, Dark=#F85149}"
                                        Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Toggle Button -->
                <Button
                    Text="Show Closed Incidents"
                    Command="{Binding LoadClosedIncidentsCommand}"
                    FontSize="15"
                    FontFamily="OpenSansSemibold"
                    BackgroundColor="Transparent"
                    BorderColor="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                    BorderWidth="1"
                    CornerRadius="8"
                    Margin="16,0"
                    TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowClosed}" Value="True">
                            <Setter Property="Text" Value="Hide Closed Incidents" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Closed Incidents -->
                <CollectionView
                    ItemsSource="{Binding ClosedIncidents}"
                    IsVisible="{Binding ShowClosed}"
                    SelectionMode="None"
                    BackgroundColor="Transparent"
                    Margin="0,8,0,0">
                    <CollectionView.Header>
                        <Label
                            Text="Closed Incidents"
                            FontSize="18"
                            Padding="16,8,16,0"
                            FontFamily="OpenSansSemibold"
                            TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IncidentDto">
                            <Border
                                BackgroundColor="{AppThemeBinding Light=#FAFBFC, Dark=#0D1117}"
                                Stroke="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 10"
                                Opacity="0.8"
                                Margin="16,4,16,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentListViewModel}}, Path=NavigateToDetailCommand}" 
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Row="0" 
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        FontSize="16"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                                        LineBreakMode="TailTruncation" />
                                    <Border
                                        Grid.Row="0" 
                                        Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2D2D2D}"
                                        Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                        StrokeThickness="1"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="{Binding Priority}"
                                            FontSize="12"
                                            FontFamily="OpenSansRegular"
                                            TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    </Border>
                                    <Label
                                        Grid.Row="1" 
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Deadline, StringFormat='Deadline: {0:dd MMM yyyy HH:mm}', TargetNullValue='No deadline'}"
                                        FontSize="13"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                                        Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom nav bar -->
        <views:BottomNavBar
            Grid.Row="1"
            CurrentPage="IncidentListPage" />

        <!-- Loading overlay -->
        <Grid
            IsVisible="{Binding IsLoading}"
            InputTransparent="False"
            BackgroundColor="{StaticResource OverlayDark}">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="White" />
        </Grid>
    </Grid>
</ContentPage>