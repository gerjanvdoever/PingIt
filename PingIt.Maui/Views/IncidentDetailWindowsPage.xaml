<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    xmlns:dto="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
    x:Class="PingIt.Maui.Views.IncidentDetailWindowsPage"
    x:DataType="vm:IncidentDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D1117}"
    Title="Incident Details">

    <Grid RowDefinitions="Auto,*,Auto">

        <views:TopNavBar Grid.Row="0" Title="{Binding Incident.Title}" ShowBackButton="True" />

        <ScrollView Grid.Row="1" Padding="16">
            <Grid ColumnDefinitions="2*,1*" RowDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="16">

                <!-- Left Column -->
                <VerticalStackLayout Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Spacing="16">

                    <!-- Header Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="32,24"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="{Binding Incident.Title}" FontSize="24" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                                <Label Text="{Binding Incident.CreatedAt, StringFormat='Created: {0:dd MMM yyyy HH:mm}'}"
                                       FontSize="14" FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark=#332701}"
                                    Stroke="{AppThemeBinding Light=#FFEAA7, Dark=#664D03}" StrokeThickness="1"
                                    Padding="12,6" StrokeShape="RoundRectangle 20" VerticalOptions="Start">
                                <Label Text="{Binding Incident.Priority, StringFormat='Priority: {0}'}" FontSize="12"
                                       FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light=#664D03, Dark=#FFDA6A}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Description Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="32,24"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Description" FontSize="18" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <Label Text="{Binding Incident.Description}" FontSize="15" FontFamily="OpenSansRegular"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Photos Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="32,24"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Photos" FontSize="18" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                                <Label Grid.Column="1" Text="{Binding Incident.Photos.Count, StringFormat='{0} photos'}"
                                       FontSize="13" FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Incident.Photos}" VerticalOptions="FillAndExpand">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:IncidentPhotoDto">
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="Transparent">
                                            <Border.Shadow>
                                                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}"
                                                        Offset="0,2" Radius="6" Opacity="0.15" />
                                            </Border.Shadow>
                                            <Border StrokeShape="RoundRectangle 12"
                                                    Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#21262D}">
                                                <Image Source="{Binding PhotoUrl}" Aspect="AspectFit" HeightRequest="250" VerticalOptions="FillAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentDetailViewModel}}, Path=ShowFullscreenImageCommand}" CommandParameter="{Binding PhotoUrl}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Right Column -->
                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Spacing="16">

                    <!-- Details Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="24,20"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="20">
                            <Label Text="Details" FontSize="16" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />

                            <VerticalStackLayout Spacing="12">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Deadline" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Label Text="{Binding Incident.Deadline, StringFormat='{0:dd MMM yyyy HH:mm}', TargetNullValue='None'}"
                                           FontSize="14" FontFamily="OpenSansRegular"
                                           TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Handled Externally" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Label Text="No" FontSize="14" FontFamily="OpenSansRegular"
                                           TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Incident.HandledByExternal}" Value="True">
                                                <Setter Property="Text" Value="Yes" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Location Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="24,20"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Location" FontSize="16" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Map view is not available on this device." FontSize="13"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                <Button Text="Open in Google Maps" Command="{Binding OpenInGoogleMapsCommand}" FontSize="14"
                                        Padding="16,10" CornerRadius="8" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Status, notes -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}" Padding="24,20"
                            StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Status &amp; Notes" FontSize="16" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#24292F, Dark=#F0F6FC}" />
                            <VerticalStackLayout Spacing="12">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Status" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                            Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1"
                                            Padding="8,4" StrokeShape="RoundRectangle 6">
                                        <Picker ItemsSource="{Binding StatusOptions}"
                                                SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                                Title="Select status" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Notes" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#21262D}"
                                            Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1"
                                            Padding="16,12" StrokeShape="RoundRectangle 8">
                                        <Editor Text="{Binding Incident.Notes, Mode=TwoWay}"
                                                AutoSize="TextChanges"
                                                Placeholder="Enter notes..."
                                                MinimumHeightRequest="120" />
                                    </Border>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- Action Bar -->
        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}" StrokeThickness="1" Padding="20,16">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E1E4E8, Dark=#21262D}" Offset="0,-2" Radius="8" Opacity="0.1" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" HorizontalOptions="Fill">
                <Label Grid.Column="0" Text="Make your changes and save when ready"
                       FontSize="14" TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Save Changes" Command="{Binding ChangeStatusCommand}" FontSize="16"
                        FontFamily="OpenSansSemibold" TextColor="White" BackgroundColor="{StaticResource Primary}"
                        CornerRadius="10" Padding="32,12" HorizontalOptions="End" />
            </Grid>
        </Border>

        <!-- image overlay for fullscreen -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsImageFullscreen}" BackgroundColor="#CC000000" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseFullscreenImageCommand}" />
            </Grid.GestureRecognizers>
            <Border BackgroundColor="Black" StrokeShape="RoundRectangle 12" Margin="20"
                    VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.3" />
                </Border.Shadow>
                <Grid RowDefinitions="*,Auto">
                    <Image Source="{Binding FullscreenImageUrl}" Aspect="AspectFit"
                           HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                    <Button Grid.Row="1" Text="✕" Command="{Binding CloseFullscreenImageCommand}"
                            BackgroundColor="#80000000" TextColor="White" FontSize="18" CornerRadius="20"
                            WidthRequest="40" HeightRequest="40" HorizontalOptions="End" VerticalOptions="Start"
                            Margin="8" />
                </Grid>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" InputTransparent="False" BackgroundColor="{StaticResource OverlayDark}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center"
                               VerticalOptions="Center" Color="White" />
        </Grid>

    </Grid>
</ContentPage>
