<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:models="clr-namespace:PingIt.Shared.Dtos;assembly=PingIt.Shared"
             xmlns:conv="clr-namespace:PingIt.Maui.Converters"
             x:Class="PingIt.Maui.Views.MapView">
    <ContentView.Resources>
        <conv:DtoToLocationConverter x:Key="DtoToLocationConverter" />
    </ContentView.Resources>
    <Grid>
        <maps:Map 
      x:Name="InternalMap"
      IsShowingUser="{Binding ShowUserLocation}"
      IsZoomEnabled="True"
      IsScrollEnabled="True"
      MapClicked="OnMapClicked"
      ItemsSource="{Binding PinItems}">

            <!-- Template for rendering each pin -->
            <maps:Map.ItemTemplate>
                <DataTemplate x:DataType="models:LocationDto">
                    <maps:Pin
                     Type="Place"
                     Location="{Binding ., Converter={StaticResource DtoToLocationConverter}}" />
                </DataTemplate>
            </maps:Map.ItemTemplate>
        </maps:Map>
    </Grid>
</ContentView>