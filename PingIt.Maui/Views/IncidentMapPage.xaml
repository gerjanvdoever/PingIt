<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PingIt.Maui.Views"
    xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"
    x:Class="PingIt.Maui.Views.IncidentMapPage"
    Title="Incident Map">

    <Grid RowSpacing="0" ColumnSpacing="0" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:MapView
      Grid.Row="0"
      PinItems="{Binding PinItems}"
      SelectedLocation="{Binding SelectedLocation, Mode=TwoWay}"
      ShowUserLocation="True"
      IsPinSelectionEnabled="False"
      AllowDetailNavigation="True"/>
        <views:BottomNavBar
      Grid.Row="1"
      CurrentPage="IncidentMapPage"
      HorizontalOptions="FillAndExpand" />
    </Grid>
</ContentPage>
