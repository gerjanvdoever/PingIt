<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
            xmlns:vm="clr-namespace:PingIt.Maui.ViewModels"  
            x:Class="PingIt.Maui.Views.LoginPage"
            x:DataType="vm:LoginViewModel"
            Title="Login">  

   <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">  

       <Image Source="logo.png" HeightRequest="100" HorizontalOptions="Center" />  

       <Entry Placeholder="E-mail"  
              Text="{Binding Email}"  
              Keyboard="Email" />  

       <Entry Placeholder="Wachtwoord"  
              Text="{Binding Password}"  
              IsPassword="True" />

        <Label Text="{Binding ValidationError}" 
       TextColor="Red" 
       IsVisible="{Binding ValidationError, Converter={StaticResource StringNotEmptyConverter}}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"  
                          IsVisible="{Binding IsBusy}" />  

       <Button Text="Inloggen"  
               Command="{Binding LoginCommand}"  
               IsEnabled="{Binding IsNotBusy}" />

        <Button Text="Registreren"
               Command="{Binding RegisterCommand}"
               IsEnabled="{Binding IsNotBusy}" />

        <Button Text="Ik wil anoniem een incident melden"  
               Command="{Binding AnonymousCommand}"  
               IsEnabled="{Binding IsNotBusy}" />  

   </VerticalStackLayout>  
</ContentPage>
