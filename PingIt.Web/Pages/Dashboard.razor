@page "/dashboard"
@using PingIt.Web.Pages.Base
@using PingIt.Shared.Enums
@using PingIt.Web.Components
@attribute [Authorize(Roles = "Administrator")]
@inherits BaseAdminPage

<input type="text"
       placeholder="Search title..."
       @bind="TitleFilter"
       @bind:event="oninput"
       class="form-control mb-3" />

<h5>Active Incidents</h5>

<table class="table">
    <thead>
        <tr>
            <th @onclick='() => SortBy("Title")'>Title</th>
            <th @onclick='() => SortBy("CreatedAt")'>Created At</th>
            <th @onclick='() => SortBy("Status")'>Status</th>
            <th @onclick='() => SortBy("Priority")'>Priority</th>
            <th @onclick='() => SortBy("HandledByUserId")'>Handled By User</th>
            <th @onclick='() => SortBy("HandledByExternal")'>External?</th>
            <th>Deadline</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var incident in PagedActive)
        {
            <tr>
                <td>@incident.Title</td>
                <td>@incident.CreatedAt.ToString("g")</td>
                <td>
                    <select @onchange="e => OnStatusChanged(incident, e.Value?.ToString())">
                        @foreach (var status in Enum.GetValues<IncidentStatus>())
                        {
                            <option value="@status" selected="@(incident.Status == status)">
                                @status
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <select @onchange="e => OnPriorityChanged(incident, e.Value?.ToString())">
                        @foreach (var level in Enum.GetValues<PriorityLevel>())
                        {
                            <option value="@level" selected="@(incident.Priority == level)">
                                @level
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <select @onchange="e => OnWorkerSelected(incident, e.Value?.ToString())">
                        <option value="">-- Select --</option>
                        @foreach (var worker in Workers)
                        {
                            <option value="@worker.Id" selected="@(incident.HandledByUserId == worker.Id)">
                                @worker.FirstName @worker.LastName
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <select @onchange="e => OnExternalSelected(incident, e.Value?.ToString())">
                        <option value="true" selected="@(incident.HandledByExternal)">Yes</option>
                        <option value="false" selected="@(!incident.HandledByExternal)">No</option>
                    </select>
                </td>
                <td>
                    <input type="datetime-local"
                           value="@incident.Deadline?.ToString("yyyy-MM-ddTHH:mm")"
                           @onchange="e => OnDeadlineChanged(e, incident)"
                           class="form-control" />
                </td>
                <td>
                    <button class="btn btn-primary btn-sm" @onclick="@(() => NavigateToDetail(incident.Id))">Details</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteIncidentAsync(incident)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-between mt-2">
    <button class="btn btn-sm btn-secondary me-2" @onclick="() => ActivePage--" disabled="@(ActivePage == 1)">Prev</button>
    <button class="btn btn-sm btn-secondary" @onclick="() => ActivePage++" disabled="@(ActivePage * PageSize >= FilteredActive.Count())">Next</button>
</div>


@if (FilteredActive.Any())
{
    <div class="mt-4">
        <IncidentMap Incidents="FilteredActive.ToList()" />
    </div>
}

<h5 class="mt-5">Closed Incidents</h5>

@if (!ShowClosedIncidents)
{
    <button class="btn btn-info" @onclick="LoadClosedIncidentsAsync">Load Closed Incidents</button>
}
else
{
    @if (IsClosedLoading)
    {
        <p>Loading closed incidents...</p>
    }
    else
    {
        <table class="table-bordered table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Created At</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Handled By</th>
                    <th>External?</th>
                    <th>Deadline</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in PagedClosed)
                {
                    <tr>
                        <td>@incident.Title</td>
                        <td>@incident.CreatedAt.ToString("g")</td>
                        <td>@incident.Status</td>
                        <td>@incident.Priority</td>
                        <td>@GetWorkerName(incident.HandledByUserId)</td>
                        <td>@(incident.HandledByExternal ? "Yes" : "No")</td>
                        <td>@incident.Deadline?.ToString("g")</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="@(() => NavigateToDetail(incident.Id))">Details</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-sm btn-secondary me-2" @onclick="() => ClosedPage--" disabled="@(ClosedPage == 1)">Prev</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => ClosedPage++" disabled="@(ClosedPage * PageSize >= FilteredClosed.Count())">Next</button>
    }
}

<button @onclick="NavigateAdminPanel" class="btn btn-secondary mt-3"> Admin Panel</button>
<button @onclick="Logout" class="btn btn-secondary mt-3">Logout</button>
