@page "/adminpanel"
@using PingIt.Web.Pages.Base
@using PingIt.Shared.Enums
@using PingIt.Shared.Dtos
@attribute [Authorize(Roles = "Administrator")]
@inherits BaseAdminPage

<div class="border-b border-gray-200 bg-white px-6 py-4 shadow-sm">
    <div class="flex items-center justify-between">
        <a href="/dashboard"
           class="inline-flex items-center rounded-lg bg-gray-500 px-4 py-2 font-medium text-white transition-colors duration-200 hover:bg-gray-600">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back
        </a>
    </div>
</div>

<div class="min-h-screen bg-gray-50 px-6 py-6 font-sans">
    <div class="mx-auto max-w-[95%]">
        <div class="mb-8">
            <h1 class="mb-2 text-3xl font-bold text-gray-900">Residents</h1>
            <p class="text-gray-600">Manage residents in your community</p>

            @if (allUsers.Count > MaxVisible)
            {
                <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4">
                    <p class="text-sm text-blue-700">
                        Showing only the first 40 users. Please filter to see specific users.
                    </p>
                </div>
            }
        </div>

        <div class="overflow-hidden rounded-2xl bg-white shadow-xl">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="border-b border-gray-200 bg-gray-50">
                        <tr>
                            <th class="w-[14%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="FirstNameFilter"
                                       @bind:event="oninput"
                                       placeholder="Search first name..." />
                            </th>
                            <th class="w-[14%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="LastNameFilter"
                                       @bind:event="oninput"
                                       placeholder="Search last name..." />
                            </th>
                            <th class="w-[18%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="EmailFilter"
                                       @bind:event="oninput"
                                       placeholder="Search email..." />
                            </th>
                            <th class="w-[16%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="StreetFilter"
                                       @bind:event="oninput"
                                       placeholder="Search street..." />
                            </th>
                            <th class="w-[12%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="PostalFilter"
                                       @bind:event="oninput"
                                       placeholder="Search postal code..." />
                            </th>
                            <th class="w-[12%] px-6 py-4 text-left">
                                <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                       @bind="CityFilter"
                                       @bind:event="oninput"
                                       placeholder="Search city..." />
                            </th>
                            <th class="w-[14%] px-6 py-4 text-left">
                                <span class="text-sm font-medium text-gray-700">Role</span>
                            </th>
                        </tr>
                    </thead>

                    <thead class="border-b border-gray-200 bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">First Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Last Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Street</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Postal Code</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">City</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Role</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-200 bg-white">
                        @foreach (var user in filteredUsers)
                        {
                            <tr class="transition-colors duration-150 hover:bg-gray-50">
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">@user.FirstName</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">@user.LastName</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-blue-600">@user.Email</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                                    @user.Street @user.HouseNumber
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">@user.PostalCode</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">@user.City</td>
                                <td class="whitespace-nowrap px-6 py-4">
                                    <select class="min-w-[120px] rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                            @onchange="e => OnRoleChanged(user, e)">
                                        @foreach (var role in Enum.GetValues<UserRole>())
                                        {
                                            <option value="@role" selected="@(user.Role == role)">
                                                @role
                                            </option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
