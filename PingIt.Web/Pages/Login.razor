@page "/"
@page "/login"
@using PingIt.Shared.Dtos
@using Microsoft.AspNetCore.Components.Forms

<div class="flex min-h-screen items-center justify-center bg-[#1ECAFF] px-4 font-sans sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
        <div class="flex justify-center">
            <img src="images/pingit.png" alt="Your Logo" class="h-32 w-auto" />
        </div>
        <div class="rounded-2xl bg-white px-8 py-12 shadow-xl">


            @if (error != null)
            {
                <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">
                    <p class="text-center text-sm text-red-600">@error</p>
                </div>
            }

            <EditForm Model="@dto" OnValidSubmit="HandleLogin" class="space-y-6">
                <DataAnnotationsValidator />
                <ValidationSummary class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" />

                <div class="space-y-2">
                    <div class="relative">
                        <InputText name="email"
                                   class="w-full rounded-xl border-0 bg-gray-50 px-4 py-4 text-gray-900 placeholder-gray-500 transition-all duration-200 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
                                   @bind-Value="dto.Email"
                                   placeholder="Email" />
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="relative">
                        <InputText type="password" name="psw"
                                   class="w-full rounded-xl border-0 bg-gray-50 px-4 py-4 text-gray-900 placeholder-gray-500 transition-all duration-200 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
                                   @bind-Value="dto.Password"
                                   placeholder="Password" />
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit"
                            class="w-full transform rounded-xl bg-blue-500 px-6 py-4 font-semibold text-white shadow-lg transition-all duration-200 hover:bg-blue-600 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Log in
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>