@page "/"
@page "/login"
@inject IAuthService Auth
@inject NavigationManager Nav
@using PingIt.Shared.Dtos
@using Microsoft.AspNetCore.Components.Forms

<h3 class="mt-5">Admin Portal Login</h3>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<EditForm Model="@dto" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="dto.Email" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText class="form-control" @bind-Value="dto.Password" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</EditForm>

@code {
    private LoginDto dto = new();
    private string? error;

    private async Task HandleLogin()
    {
        var ok = await Auth.LoginAsync(dto);
        if (!ok)
        {
            error = "Invalid credentials or non-admin user.";
            return;
        }
        Nav.NavigateTo("/dashboard", replace: true);
    }
}
