@page "/"
@page "/login"
@using PingIt.Shared.Dtos
@using Microsoft.AspNetCore.Components.Forms

<div class="min-h-screen w-screen bg-gradient-to-r from-indigo-50 to-indigo-200 pt-16">
    <p class="py-4 text-center text-3xl font-semibold text-black">LOGIN</p>

    <div class="mx-auto my-3 w-4/5 rounded-md bg-white px-4 py-4 shadow-lg md:w-3/5 lg:w-2/5 2xl:w-1/5">
        @if (error != null)
        {
            <p class="mb-4 text-center text-sm text-red-500">@error</p>
        }

        <EditForm Model="@dto" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-2 text-sm text-red-600" />

            <label for="email" class="block px-3 py-1 text-sm font-medium text-gray-700">Email</label>
            <p>
                <InputText name="email"
                           class="mx-3 mb-3 block w-[95%] rounded-md border-2 border-gray-400 px-3 py-2.5"
                           @bind-Value="dto.Email"
                           placeholder="Enter your email" />
            </p>

            <label for="psw" class="block px-3 py-1 text-sm font-medium text-gray-700">Password</label>
            <p>
                <InputText type="password" name="psw"
                           class="mx-3 block w-[95%] rounded-md border-2 border-gray-400 px-3 py-2.5"
                           @bind-Value="dto.Password"
                           placeholder="password" />
            </p>

            <button type="submit"
                    class="mx-auto mt-3 block rounded border-2 bg-indigo-50 px-2 py-1 transition-all duration-200 hover:bg-indigo-100">
                LOGIN
            </button>
        </EditForm>
    </div>
</div>
