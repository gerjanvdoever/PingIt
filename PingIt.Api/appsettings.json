{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "PostgresConnection": "Host=localhost;Port=5432;Database=pingitdb;Username={username};Password={password}"
    },
    "Jwt": {
        "Issuer": "PingItApi",
        "Audience": "PingItClients",
        "ExpireMinutes": 10080
    },
    "AllowedHosts": "*"
}
